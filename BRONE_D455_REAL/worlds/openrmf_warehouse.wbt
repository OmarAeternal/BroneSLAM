    # ==========================================================
    # Intel RealSense D455 Sensor Suite -- DISESUAIKAN KE KAMERA ASLI
    # (serial 135122251358, diukur 2026-11-09, lihat ~/brone/D455_SPEK_ASLI)
    # camera_link = titik optik depth (imager kiri) di x=+0.08, z=+0.10 dari base_link
    # Noise depth, jarak minimum 0.293 m, bayangan stereo, bias gyro, dll.
    # dimodelkan di rtabmap_rgbd/src/d455_real_model.py (bukan di sini).
    # ==========================================================
    DEF IMU InertialUnit {
      translation 0.08 0 0.10
      # HANYA untuk ground-truth. D455 asli TIDAK punya orientasi absolut.
      name "imu"
    }
    DEF GYRO Gyro {
      # ekstrinsik Depth->IMU t = (-30.22, +7.40, +16.02) mm (frame optik)
      # -> titik IMU di frame depth = -t -> camera_link (x,y,z) = (-16.02, -30.22, +7.40) mm
      translation 0.06398 -0.03022 0.1074
      name "gyro"
    }
    DEF ACCEL Accelerometer {
      translation 0.06398 -0.03022 0.1074
      name "accelerometer"
    }
    DEF GPS GPS {
      name "gps"
    }
    DEF D455_COLOR Camera {
      # ekstrinsik Depth->Color t = (-59.12, +0.15, +0.58) mm (frame optik)
      # -> titik optik color di frame depth = -t -> camera_link (x,y,z) = (-0.58, -59.12, +0.15) mm
      #    (kamera warna 59 mm di KANAN imager depth)
      translation 0.07942 -0.05912 0.10015
      name "d455_color"
      width 640
      height 480
      # fx asli 640x480 = 379.907 px -> FOV-H = 2*atan(320/379.907) = 80.21 deg
      fieldOfView 1.40003
    }
    DEF D455_DEPTH RangeFinder {
      translation 0.08 0 0.10
      name "d455_depth"
      width 640
      height 480
      # fx asli 640x480 = 387.070 px -> FOV-H = 2*atan(320/387.070) = 79.16 deg
      fieldOfView 1.38166
      # near-plane render dibiarkan kecil; batas 0.293 m diterapkan di model
      # (benda < 0.293 m harus jadi 0/kosong, BUKAN tembus pandang)
      minRange 0.05
      maxRange 6.0
    }
  ]
  boundingObject USE BODY_TRANS
  physics Physics {
  }
  name "brone_robot"
  controller "<extern>"
